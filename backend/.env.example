# Скопируйте в .env и поправьте под себя. Без .env сервер стартует в безопасном режиме:
# LLM — mock (без ключей и сети), поиск — wardrobe_rag, а если он не готов — встроенный BM25.

# --- LLM -------------------------------------------------------------------------
# mock   — шаблонный ответ вокруг детерминированной сборки, ключи не нужны
# openai — любой OpenAI-совместимый /chat/completions (OpenRouter, Ollama, vLLM, LM Studio, OpenAI)
LLM_PROVIDER=mock

# Qwen через OpenRouter (нужен ключ с https://openrouter.ai/keys; актуальное имя модели — на openrouter.ai/models):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-27b:free
# LLM_API_KEY=sk-or-...

# Qwen локально через Ollama (работает без интернета; сначала `ollama pull qwen3:8b`):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

LLM_TEMPERATURE=0.6
LLM_TIMEOUT_S=30
# Сколько раз просим модель исправить ответ, не прошедший проверку, прежде чем уйти в фолбэк
LLM_MAX_REPAIRS=1
# Выключите, если провайдер не понимает response_format={"type":"json_object"}
LLM_JSON_MODE=true
# Включите для Ollama с поддержкой JSON Schema (prefixItems); не нужно для остальных провайдеров.
LLM_OUTFIT_SCHEMA=false
# Доп. поля тела запроса к LLM (JSON-объект), например опции reasoning конкретного провайдера
LLM_EXTRA_BODY=

# --- Поиск (RAG) -------------------------------------------------------------------
# auto — wardrobe_rag, а если пакет/модели недоступны — встроенный BM25 (с явной пометкой в ответах)
# wardrobe_rag — только пакет из ../rag; сервер не стартует, если он не готов (ставьте это на показе)
# builtin — встроенный лексический поиск
RAG_ENGINE=auto
RAG_MODE=hybrid
RAG_ALPHA=0.65
RAG_VISUAL_WEIGHT=0.35
# Пути считаются от каталога backend/
RAG_DATA_DIR=../rag/.rag_data
RAG_CACHE_DIR=../rag/.model_cache
RAG_PUBLIC_ROOT=../public
RAG_UPLOAD_ROOT=
# true — модели только из локального кеша, без обращения к сети (после `init-models`)
RAG_OFFLINE=false
RAG_DEVICE=cpu
# Переиспользовать эмбеддинги неизменённых вещей (файл embedding_cache.sqlite3 в RAG_DATA_DIR).
# false нужен только чтобы снять замер «до»: тогда правка одной вещи перекодирует весь каталог.
RAG_EMBEDDING_CACHE=true
# Начальный гардероб демо-пользователя (user_id=demo). Пусто — капсула из 50 вещей.
# Для сценария с погодной разметкой: ../rag/data/wardrobe_demo_weather.json
SEED_WARDROBE_PATH=

# --- Сервер ------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
DATABASE_PATH=data/stylist.db
# Токен для PUT /api/admin/settings (заголовок X-Admin-Token). Пусто — изменение настроек отключено.
ADMIN_TOKEN=
LOG_LEVEL=INFO
