{
  "$defs": {
    "QueryContext": {
      "additionalProperties": false,
      "properties": {
        "occasion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occasion"
        },
        "weather": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weather"
        },
        "vibe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vibe"
        },
        "temperature_c": {
          "anyOf": [
            {
              "maximum": 65,
              "minimum": -80,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "rain": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rain"
        },
        "wind": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind"
        }
      },
      "title": "QueryContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Search for a single change to an existing outfit from this user's wardrobe.",
  "properties": {
    "user_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "User Id",
      "type": "string"
    },
    "query": {
      "maxLength": 10000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "slot": {
      "enum": [
        "tops",
        "bottoms",
        "shoes",
        "outerwear",
        "accessories"
      ],
      "title": "Slot",
      "type": "string"
    },
    "operation": {
      "enum": [
        "add",
        "replace"
      ],
      "title": "Operation",
      "type": "string"
    },
    "outfit_item_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Outfit Item Ids",
      "type": "array"
    },
    "replace_item_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replace Item Id"
    },
    "context": {
      "$ref": "#/$defs/QueryContext"
    },
    "exclude_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Item Ids",
      "type": "array"
    },
    "exclude_colors": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Colors",
      "type": "array"
    },
    "exclude_materials": {
      "items": {
        "type": "string"
      },
      "title": "Exclude Materials",
      "type": "array"
    },
    "without_heel": {
      "default": false,
      "title": "Without Heel",
      "type": "boolean"
    },
    "mode": {
      "default": "hybrid",
      "enum": [
        "bm25",
        "dense",
        "hybrid",
        "multimodal"
      ],
      "title": "Mode",
      "type": "string"
    },
    "alpha": {
      "default": 0.65,
      "maximum": 1,
      "minimum": 0,
      "title": "Alpha",
      "type": "number"
    },
    "visual_weight": {
      "default": 0.35,
      "maximum": 1,
      "minimum": 0,
      "title": "Visual Weight",
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "query",
    "slot",
    "operation",
    "outfit_item_ids"
  ],
  "title": "SlotSearchRequest",
  "type": "object"
}